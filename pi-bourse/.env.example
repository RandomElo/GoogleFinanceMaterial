# Copier ce fichier en .env et le remplir : cp .env.example .env

# --- Obligatoire ---

# Clé exigée sur toutes les routes sauf /health (en-tête X-API-Key ou Authorization: Bearer).
# 16 caractères minimum. Générer : openssl rand -hex 32
API_KEY=

# Base "bourse" du Postgres commun : mêmes <user> et <mot_de_passe> que POSTGRES_USER et
# POSTGRES_PASSWORD dans ../commun/.env. Un mot de passe contenant @ : / # ? doit être encodé (%40, %3A…).
DATABASE_URL=postgresql://<user>:<mot_de_passe>@postgres:5432/bourse

# --- Synchronisation des opérations (Google Sheet) ---
# Désactivée tant que la clé du compte de service n'est pas posée dans ./secrets/google.json
# ou que GOOGLE_SHEET_ID est vide. Après les avoir ajoutés : docker compose restart api

# Identifiant du Sheet : la partie entre /d/ et /edit dans son URL
GOOGLE_SHEET_ID=
# Onglets lus (voir README pour les colonnes attendues)
GOOGLE_ONGLET_OPERATIONS=Historique d'opérations
GOOGLE_ONGLET_DIVIDENDES=Dividendes
# Chemin de la clé DANS le conteneur (./secrets est monté sur /app/secrets). Ne changer que
# si le fichier posé dans ./secrets porte un autre nom.
GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/google.json

# --- Optionnel ---

# Durée du cache des cotations du moment (GET /cotations), en secondes
CACHE_COTATIONS_SECONDES=300
# Port d'écoute dans le conteneur (le compose publie 8140)
PORT=8140
