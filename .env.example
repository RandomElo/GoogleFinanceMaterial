# Clé de l'API bourse (API_KEY de son .env). Elle reste côté serveur (Vite ou nginx), jamais dans le navigateur.
API_KEY=

# Les deux adresses de l'API (hôte:port). Celle qui répond est choisie automatiquement.
API_VPN=100.64.0.8:8140
API_LAN=192.168.1.31:8140

# Port publié par le conteneur (docker compose)
PORT=8150
